<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>com.devopsaaas</groupId>
    <artifactId>devops-aaas-parent</artifactId>
    <version>0.1.0</version>
    <packaging>pom</packaging>
    <name>DevOps AaaS</name>
    <description>Secure control plane for operations agents</description>

    <modules>
        <module>backend</module>
        <module>demo-api</module>
    </modules>

    <properties>
        <java.version>25</java.version>
        <archunit.version>1.5.1</archunit.version>
        <jacoco.version>0.8.15</jacoco.version>
        <spotbugs-maven-plugin.version>4.10.4.1</spotbugs-maven-plugin.version>
        <findsecbugs.version>1.14.0</findsecbugs.version>
        <spotbugs-annotations.version>4.10.4</spotbugs-annotations.version>
        <!-- Not managed by Spring Boot 4.1.1 -->
        <caffeine.version>3.3.0</caffeine.version>
        <!-- Slice 9c (finding 9c-01): Spring Boot 4.1.1 manages 11.0.24, which Trivy reports with three critical
             CVEs fixed in 11.0.25. Override through the BOM's own property; drop it once Boot manages 11.0.26+. -->
        <tomcat.version>11.0.26</tomcat.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.github.ben-manes.caffeine</groupId>
                <artifactId>caffeine</artifactId>
                <version>${caffeine.version}</version>
            </dependency>
            <dependency>
                <groupId>com.github.spotbugs</groupId>
                <artifactId>spotbugs-annotations</artifactId>
                <version>${spotbugs-annotations.version}</version>
            </dependency>
            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit-junit5</artifactId>
                <version>${archunit.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>${jacoco.version}</version>
                </plugin>
                <plugin>
                    <groupId>com.github.spotbugs</groupId>
                    <artifactId>spotbugs-maven-plugin</artifactId>
                    <version>${spotbugs-maven-plugin.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-build-environment</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>[${java.version},)</version>
                                </requireJavaVersion>
                                <requireMavenVersion>
                                    <version>[3.9,)</version>
                                </requireMavenVersion>
                                <banDuplicatePomDependencyVersions/>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
