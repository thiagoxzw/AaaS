# Copie para .env e troque todos os valores. O arquivo .env nunca é versionado.
# Sem estes valores o docker compose se recusa a subir (não há senha padrão).
POSTGRES_PASSWORD=change-me-postgres
GRAFANA_ADMIN_PASSWORD=change-me-grafana

# Chave de assinatura dos JWT (HS256). Mínimo de 32 bytes. Gere com: openssl rand -base64 48
JWT_SECRET=change-me-generate-with-openssl-rand-base64-48

# Primeiro administrador, criado apenas quando o banco ainda não tem usuários. Senha com 12+ caracteres.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin-password

# Provedor do LLM do agente: "scripted" (roteiros determinísticos, sem API key) ou "openai".
LLM_PROVIDER=scripted

# Só para LLM_PROVIDER=openai. Sem qualquer um destes, o backend não sobe.
# O conteúdo enviado ao modelo (inclusive logs, já mascarados) sai da sua máquina: veja o README.
OPENAI_API_KEY=
# O nome exato do modelo, como aparece na documentação da OpenAI (sem valor padrão de propósito).
LLM_MODEL=
# Preços em USD por milhão de tokens, copiados da página de preços da OpenAI para o modelo escolhido.
LLM_PRICE_INPUT_PER_MTOK_USD=
LLM_PRICE_OUTPUT_PER_MTOK_USD=
# Gasto estimado máximo por organização e dia UTC; ao estourar, novas mensagens recebem 429.
LLM_DAILY_BUDGET_USD=
